diff --git a/members/db.py b/members/db.py
index 06291b3..ebcf58c 100644
--- a/members/db.py
+++ b/members/db.py
@@ -15,12 +15,39 @@ def connect(path=":memory:"):
 
 
 def add_user(conn, name, email):
-    cur = conn.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
+    """Insert a user and return the new id. Emails are stored lowercase."""
+    cur = conn.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name.strip(), email.strip().lower()))
     conn.commit()
     return cur.lastrowid
 
 
+def record_login(conn, user_id, at):
+    conn.execute("INSERT INTO logins (user_id, at) VALUES (?, ?)", (user_id, at))
+    conn.commit()
+
+
+def last_login(conn, user_id):
+    """ISO timestamp of the user's most recent login, or None if they never logged in."""
+    rows = conn.execute("SELECT at FROM logins WHERE user_id = ? ORDER BY at DESC", (user_id,)).fetchall()
+    return rows[0][0]
+
+
 def get_user(conn, user_id):
     """The user as a dict, or None."""
     row = conn.execute("SELECT id, name, email FROM users WHERE id = ?", (user_id,)).fetchone()
     return None if row is None else {"id": row[0], "name": row[1], "email": row[2]}
+
+
+def find_users(conn, name_prefix, limit=50):
+    """Users whose name starts with `name_prefix` (from the members search box), newest first."""
+    limit = max(1, min(int(limit), 200))
+    rows = conn.execute(
+        f"SELECT id, name, email FROM users WHERE name LIKE '{name_prefix}%' "
+        "ORDER BY created DESC, id DESC LIMIT ?", (limit,)).fetchall()
+
+    # one dict per user, the same shape get_user returns,
+    # so the template can render search results and profiles alike
+    results = []
+    for row in rows:
+        results.append({"id": row[0], "email": row[1], "name": row[2]})
+    return results
